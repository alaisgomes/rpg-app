-- MBRELIG - Member eligibility and plan limits.

CREATE TABLE MBRELIG (
    MEMBID   CHAR(12) NOT NULL,
    MEPLAN   CHAR(6)  NOT NULL,
    MEEFFD   DATE     NOT NULL,
    METRMD   DATE     NOT NULL DEFAULT '9999-12-31',
    CONSTRAINT MBRELIG_PK PRIMARY KEY (MEMBID),
    CONSTRAINT MBRELIG_DATES_CK CHECK (METRMD >= MEEFFD)
);

CREATE TABLE PLANLIM (
    MEPLAN   CHAR(6)       NOT NULL,
    CLNDC    CHAR(11)      NOT NULL,
    PLMAXQ   DECIMAL(7, 0) NOT NULL,
    CONSTRAINT PLANLIM_PK PRIMARY KEY (MEPLAN, CLNDC)
);

-- Members whose coverage ends in the next 30 days, for the outreach batch.
SELECT M.MEMBID, M.MEPLAN, M.METRMD
  FROM MBRELIG M
 WHERE M.METRMD BETWEEN CURRENT DATE AND CURRENT DATE + 30 DAYS
 ORDER BY M.METRMD;

-- Close coverage for members whose plan was terminated.
UPDATE MBRELIG
   SET METRMD = CURRENT DATE
 WHERE MEPLAN IN (SELECT PTPLAN FROM PLANTIER WHERE PTSTAT = 'T')
   AND METRMD > CURRENT DATE;
